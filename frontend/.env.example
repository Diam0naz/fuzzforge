# Frontend configuration (build-time; NEXT_PUBLIC_* is inlined at build).
# On Vercel, set these in Project Settings -> Environment Variables.

# The Fuzzforge API base URL. The frontend only shows the UI; it needs the
# API (api/ + Postgres + worker) hosted somewhere reachable from the browser.
# Until that exists, leave the default and the deployed site will load but
# cannot submit or track jobs.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Contact address shown on the site (mailto links).
NEXT_PUBLIC_CONTACT_EMAIL=jutenoh@gmail.com
