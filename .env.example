# Copy to .env and change the password before using anything but localhost.
POSTGRES_USER=fuzzforge
POSTGRES_PASSWORD=fuzzforge
POSTGRES_DB=fuzzforge

# API
BIND_ADDR=127.0.0.1:8080
STORAGE_DIR=./data
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=104857600
# Unpacked bundles that vendor their Cargo dependencies are large.
MAX_UNPACKED_BYTES=2147483648

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Worker
# Pin by digest in any environment that matters:
#   SANDBOX_IMAGE=registry.example/fuzzforge-sandbox@sha256:…
SANDBOX_IMAGE=fuzzforge/sandbox:latest
ALLOW_UNPINNED_IMAGE=1
HOST_STORAGE_DIR=./data
JOB_TIMEOUT_SECS=1800
REPRO_TIMEOUT_SECS=180
MINIMIZE=1
MINIMIZE_MAX_TRIALS=60
MINIMIZE_MAX_SECS=600
MAX_ATTEMPTS=3
STALE_AFTER_SECS=5400
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2
SANDBOX_PIDS=256
# Cold release builds of a vendored Anchor + Trident project need several GB.
SANDBOX_WORK_SIZE=8g
